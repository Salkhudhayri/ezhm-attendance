{
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/health", "destination": "/api" },
    { "source": "/api/auth/:path*", "destination": "/api" },
    { "source": "/api/employees/:path*", "destination": "/api" },
    { "source": "/api/attendance/:path*", "destination": "/api" },
    { "source": "/api/reports/:path*", "destination": "/api" },
    { "source": "/api/setup/:path*", "destination": "/api" },
    { "source": "/api/branches/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/auto-clock-out", "schedule": "0 21 * * *" }
  ]
}
